# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=datespot_dev

# Full connection string used by all services (constructed from the above in docker-compose)
DATABASE_URL="postgresql://postgres:password@localhost:5432/datespot_dev"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-at-least-32-chars-long-secret"

# ─── Email (SendGrid) ─────────────────────────────────────────────────────────
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@yourdomain.com"

# ─── SMS (Twilio) — OTP phone verification ────────────────────────────────────
# Without these, OTP codes are logged to the server console only (devCode in
# non-production responses); no real SMS is sent.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# E.164 sender number bought/verified in the Twilio console, e.g. "+15017122661"
TWILIO_FROM_NUMBER=""

# ─── Payments (Stripe) — VIP/DATING subscription purchase ─────────────────────
# Without this, /subscriptions/purchase accepts dev-receipt / raw card-last-4 only
# (no real charge). Client must collect a Stripe PaymentMethod id via
# @stripe/stripe-react-native and send it as `stripePaymentMethodId`.
# NOTE: Apple requires In-App Purchase (not Stripe) for iOS digital subscriptions —
# Stripe here is intended for Android/web; iOS needs a separate IAP + receipt-
# validation path before this flow can be used for iOS charges.
STRIPE_SECRET_KEY=""

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production

# ─── Gateway / CORS (optional, for web clients) ───────────────────────────────
# CORS_ORIGIN="https://your-web-app.com"

# ─── Google Places (per-venue photos) ─────────────────────────────────────────
# Enable Places API + Place Photos in Google Cloud Console.
GOOGLE_PLACES_API_KEY=""
# Optional fallback if you use one key for Maps + Places:
GOOGLE_MAPS_API_KEY=""
# Optional: absolute API URL for image links (e.g. Cloudflare tunnel URL).
PUBLIC_API_URL=""

# ─── OpenAI (AI chat agent) ───────────────────────────────────────────────────
# Required for full LLM recommendations. Without it, keyword quick-mode + fallback only.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_CLASSIFIER_MODEL="gpt-4o-mini"

# ─── Wolt Drive (optional scaffold — not live without a Wolt business contract) ─
# Merchant Key + venue id are issued by a Wolt account manager (no self-serve signup).
# Client scaffold: packages/places-logic/src/wolt-drive-client.ts (not mounted on routes yet).
WOLT_DRIVE_MERCHANT_KEY=""
WOLT_DRIVE_VENUE_ID=""
# Optional override (defaults to https://daas-public-api.wolt.com):
# WOLT_DRIVE_BASE_URL=""
# Reserved for marketplace OAuth (not used by Drive Merchant Key auth):
# WOLT_DRIVE_CLIENT_ID=""
# WOLT_DRIVE_CLIENT_SECRET=""
