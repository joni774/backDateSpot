# --- Core (validated at startup) ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/datespot_dev"
JWT_SECRET="datespot-super-secret-key-change-in-production-min-32-chars"
PORT=3000
NODE_ENV=development
# Origins for web clients (optional; mobile apps do not need CORS). Comma-separated, or * in dev.
CORS_ORIGIN="*"

# --- Cache (PRD 9.2 — planned; local via docker compose) ---
REDIS_URL="redis://localhost:6379"

# --- Email: SendGrid (implemented) or AWS SES (not implemented) ---
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@datespot.co.il"
# AWS SES alternative (documented only, not implemented):
AWS_SES_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
EMAIL_FROM="noreply@datespot.co.il"

# --- SMS: Twilio (implemented) — OTP phone verification ---
# Without these, OTP codes are logged to the server console only.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Image storage: S3 or Cloudinary (PRD 9.2 — planned) ---
STORAGE_PROVIDER="s3"
AWS_S3_BUCKET=""
AWS_S3_REGION=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Google Maps Platform / Places API (PRD 9.2–9.3 — planned) ---
GOOGLE_MAPS_API_KEY=""
GOOGLE_PLACES_API_KEY=""

# --- Payments: Stripe (implemented; Android/web only — iOS needs Apple IAP) ---
STRIPE_SECRET_KEY=""

# --- Planned v2 integrations (not implemented) ---
# FCM_SERVER_KEY=""
# TRANZILA_TERMINAL=""
